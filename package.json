{
	"name": "botzela",
	"version": "0.0.1",
	"type": "commonjs",
	"description": "",
	"main": "./src/index.ts",
	"scripts": {
		"start": "ts-node .",
		"start:dev": "ts-node-dev .",
		"start:prod": "node dist/index.js",
		"build": "rm -rf dist && tsc",
		"build_run": "pnpm build && pnpm start:prod",
		"lint": "prettier --check . && eslint src",
		"format": "prettier --write . && eslint src --fix",
		"eslint": "eslint ",
		"watch": "tsc -w",
		"prepare": "husky || true",
		"check-types": "tsc --pretty --noEmit",
		"check-format": "prettier --check .",
		"check-lint": "eslint src"
	},
	"dependencies": {
		"@googleapis/drive": "^8.14.0",
		"@googleapis/sheets": "^9.3.1",
		"ascii-table3": "^0.9.0",
		"axios": "^1.7.9",
		"cheerio": "1.0.0",
		"dayjs": "^1.11.13",
		"discord.js": "^14.16.3",
		"dotenv": "^16.4.7",
		"glob": "^11.0.0",
		"googleapis-common": "^7.2.0",
		"js-yaml": "^4.1.0",
		"mongoose": "^8.8.3",
		"nodemailer": "^6.9.16",
		"tslib": "^2.8.1",
		"zod": "^3.24.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WHAT-S-N3XT/botZela.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/WHAT-S-N3XT/botZela/issues"
	},
	"homepage": "https://github.com/WHAT-S-N3XT/botZela#readme",
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.17.0",
		"@types/glob": "^8.1.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.2",
		"@types/nodemailer": "^6.4.17",
		"@typescript-eslint/eslint-plugin": "^8.18.1",
		"@typescript-eslint/parser": "^8.18.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.1",
		"globals": "^15.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.4.2",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1"
	},
	"pnpm": {
		"overrides": {
			"braces@<3.0.3": ">=3.0.3",
			"micromatch@<4.0.8": ">=4.0.8"
		}
	}
}
